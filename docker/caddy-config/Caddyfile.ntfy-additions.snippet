# Phase 144 — ntfy dedicated-subdomain routing.
#
# ntfy refuses to run on a sub-path at startup ("if set, base-url must not
# have a path, as hosting ntfy on a sub-path is not supported"). Each
# instance deploys ntfy at its own dedicated subdomain (e.g. push.example.com).
# Caddy issues a Let's Encrypt cert automatically on first request via HTTP-01
# — no manual cert work. The subdomain's A-record must point at this host.
#
# SHIP-PREP ONLY — orchestrator applies this edit to
# /opt/skynet/caddy-config/Caddyfile and runs:
#   docker exec caddy caddy reload
# This file is a committed repo artifact documenting the required Caddyfile
# change. It is NOT applied by any Phase 144 plan executor.

# -----------------------------------------------------------------------
# Add a new top-level site block for the ntfy subdomain.
# The existing Skynet site block (e.g. `example.com {...}`) is UNCHANGED —
# ntfy lives at its own hostname, so there is no conflict and no need to
# restructure the existing bare `reverse_proxy skynet:8080` directive.
# -----------------------------------------------------------------------

push.example.com {
    # Caddy obtains a Let's Encrypt cert on first request via HTTP-01.
    # No manual cert management needed. The subdomain's A-record must
    # resolve to this host's public IP before the first request lands.
    log { format json; output stdout }

    # ntfy container is named `ntfy` on skynet-net; Caddy reaches it at ntfy:2586.
    # Caddy handles WebSocket/SSE upgrades automatically (long-poll + SSE are
    # how ntfy delivers to directly-connected clients).
    reverse_proxy ntfy:2586
}
