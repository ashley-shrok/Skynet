# im-SLUG.service.template — draft-terminal-on-submit
# Source: substrate/skills/interactive-messages/templates/draft-terminal-on-submit/
#
# Substitution markers replaced by create-widget.sh at scaffold time:
#   __SLUG__       → widget slug
#   __WIDGET_DIR__ → absolute path to the widget folder
#   __PORT__       → claimed port number from the 9601-9699 range

[Unit]
Description=Interactive widget: __SLUG__
After=network.target

[Service]
Type=simple
WorkingDirectory=__WIDGET_DIR__
ExecStart=/usr/bin/python3 __WIDGET_DIR__/server.py
Environment=PORT=__PORT__
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=im-__SLUG__

[Install]
WantedBy=default.target
